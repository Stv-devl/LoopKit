{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(!.env.*.example)",
      "Read(!.env.*.sample)",
      "Read(!.env.*.template)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(credentials.*)",
      "Read(.credentials.*)"
    ],
    "allow": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch -c *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(pnpm test:run)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm audit)",
      "Bash(pnpm audit *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(python3 .claude/hooks/kit-attempts.py *)",
      "Bash(python3 .claude/hooks/kit-doctor.py)",
      "Bash(python3 .claude/hooks/kit-doctor.py *)",
      "Bash(.claude/scripts/small-dispatch-check.sh *)",
      "Bash(.claude/scripts/small-paths.sh *)",
      "Bash(.claude/scripts/small-plan.sh *)",
      "Bash(.claude/scripts/small-scope.sh *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git stash list)",
      "Bash(bash .claude/hooks/test-attempts.sh)",
      "Bash(bash .claude/hooks/test-attempts.sh *)",
      "Bash(bash .claude/hooks/test-hooks.sh)",
      "Bash(bash .claude/hooks/test-hooks.sh *)",
      "Bash(bash .claude/hooks/test-install.sh)",
      "Bash(bash .claude/hooks/test-install.sh *)",
      "Bash(bash .claude/hooks/test-kit-doctor.sh)",
      "Bash(bash .claude/hooks/test-kit-doctor.sh *)",
      "Bash(bash .claude/hooks/test-measure.sh)",
      "Bash(bash .claude/hooks/test-measure.sh *)",
      "Bash(bash .claude/hooks/test-rules-floor.sh)",
      "Bash(bash .claude/hooks/test-rules-floor.sh *)",
      "Bash(bash .claude/hooks/test-small-lane.sh)",
      "Bash(bash .claude/hooks/test-small-lane.sh *)",
      "Bash(bash .claude/hooks/test-workflow-contracts.sh)",
      "Bash(bash .claude/hooks/test-workflow-contracts.sh *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-any-type.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-forbidden-icons.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/english-comments.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-architecture.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-freeze-tests.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-require-red.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prevent-destructive-commands.sh",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-git-workflow.sh",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-approve-config.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-prove-red.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-batch.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-batch.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/next-feature-on-clear.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/token-statusline.py"
  }
}
